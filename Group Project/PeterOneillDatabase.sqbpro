<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="" readonly="0" foreign_keys="" case_sensitive_like="" temp_store="" wal_autocheckpoint="" synchronous=""/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2501"/><column_width id="4" width="0"/></tab_structure><tab_browse><table title="ROLE" custom_title="0" dock_id="4" table="0,0:"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="ALL TABLES*">CREATE TABLE ROLE(
ROLE_ID INTEGER PRIMARY KEY AUTOINCREMENT,
ROLE_NAME TEXT NOT NULL
);

CREATE TABLE USER(
USER_ID INTEGER PRIMARY KEY AUTOINCREMENT,
ROLE_ID INT NOT NULL,
PASSWORD_HASH TEXT NOT NULL,
USER_FNAME TEXT NOT NULL,
USER_MNAME TEXT,
USER_LNAME TEXT NOT NULL,
USER_EMAIL UNIQUE NOT NULL,
USER_TELNO TEXT NOT NULL,
USER_DOB DATE NOT NULL,
CREATED_AT DATE NOT NULL,
ACCOUNT_STATUS TEXT NOT NULL,
FOREIGN KEY(ROLE_ID) REFERENCES ROLE(ROLE_ID) ON DELETE CASCADE ON UPDATE CASCADE
);


CREATE TABLE STAFF_TIMESHEETS(
TIMESHEETS_ID INTEGER PRIMARY KEY AUTOINCREMENT,
USER_ID INT NOT NULL,
WORK_DATE DATE NOT NULL,
HOURS_WORKED TEXT NOT NULL,
DESCRIPTION TEXT NOT NULL,
FOREIGN KEY(USER_ID) REFERENCES USER(USER_ID) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE LEAVE_REQUEST(
LEAVE_ID INTEGER PRIMARY KEY AUTOINCREMENT,
USER_ID INT NOT NULL,
START_DATE DATE NOT NULL,
END_DATE DATE NOT NULL,
REASON TEXT NOT NULL,
STSTUS TEXT NOT NULL,
FOREIGN KEY(USER_ID) REFERENCES USER(USER_ID) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE MEDIA(
MEDIA_ID INTEGER PRIMARY KEY AUTOINCREMENT,
USER_ID INT NOT NULL,
FILE_PATH TEXT NOT NULL,
TYPE TEXT NOT NULL,
FOREIGN KEY(USER_ID) REFERENCES USER(USER_ID) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE BLOGPOST(
POST_ID INTEGER PRIMARY KEY AUTOINCREMENT,
USER_ID INT NOT NULL,
TITLE TEXT NOT NULL,
CONTENT TEXT NOT NULL,
CREATED_AT INT NOT NULL,
FOREIGN KEY(USER_ID) REFERENCES USER(USER_ID) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE COMMENT(
COMMENT_ID INTEGER PRIMARY KEY AUTOINCREMENT,
USER_ID INT NOT NULL,
POST_ID INT NOT NULL,
TEXT_ TEXT NOT NULL,
CREATED_AT TEXT NOT NULL,
FOREIGN KEY(USER_ID) REFERENCES USER(USER_ID) ON DELETE CASCADE ON UPDATE CASCADE,
FOREIGN KEY(POST_ID) REFERENCES BLOGPOST(POST_ID) ON DELETE CASCADE ON UPDATE CASCADE
);
	
